# Server-side only. Leave blank for offline tests and health checks.
# Use your own football-data.org key only after reviewing its terms and your plan.
FOOTBALL_DATA_API_TOKEN=
# Comma-separated allowed browser origins; authentication cookies are not used.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Per-worker controls; restart the backend after changing these.
PROVIDER_MAX_CONCURRENCY=4
PROVIDER_QUEUE_TIMEOUT=2
CACHE_MAX_ENTRIES=256
